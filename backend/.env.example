DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-1-your-region.pooler.supabase.com:6543/postgres
JWT_SECRET=replace-with-a-long-random-jwt-secret
FRONTEND_URL=https://your-frontend-url
ADMIN_FRONTEND_URL=https://your-admin-frontend-url
ALLOWED_ORIGINS=https://your-frontend-url,https://your-admin-frontend-url
R2_ACCOUNT_ID=replace-with-your-cloudflare-account-id
R2_BUCKET_NAME=replace-with-your-r2-bucket-name
R2_ACCESS_KEY_ID=replace-with-your-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-your-r2-secret-access-key

# Do not store the admin login password in this file.
# Admin passwords belong only in the database as password hashes.
