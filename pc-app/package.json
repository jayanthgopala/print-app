{
  "name": "printshop-pc-app",
  "version": "2.0.0",
  "description": "Desktop console for direct print shop file receiving and printing",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.jayanthgopala.printshop.pcapp",
    "productName": "Print Shop Manager",
    "artifactName": "PrintShopManager-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "renderer.js",
      "clear-prices.js",
      "services/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Print Shop Manager"
    }
  },
  "dependencies": {
    "electron": "^28.0.0",
    "electron-store": "^8.1.0",
    "node-fetch": "^2.7.0",
    "node-pre-gyp": "^0.17.0",
    "pdf-to-printer": "^5.6.1",
    "qrcode": "^1.5.3",
    "wrtc": "^0.4.7",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "electron-builder": "^24.13.3"
  }
}
