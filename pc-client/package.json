{
  "name": "print-platform-pc-client",
  "version": "1.0.0",
  "description": "PC client application for cloud printing platform",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux"
  },
  "keywords": ["printing", "electron"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "ws": "^8.16.0",
    "axios": "^1.6.5",
    "pdf-to-printer": "^5.6.0",
    "dotenv": "^16.4.1",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.printplatform.pcclient",
    "productName": "Print Platform Client",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "assets/icon.png"
    }
  }
}
